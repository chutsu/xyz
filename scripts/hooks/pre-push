#!/usr/bin/env bash
# Runs the full test suite before allowing a push, so broken code (or a
# crashing test that only shows up under `make ci`) never reaches the
# remote.
set -e

# Run from the repo root regardless of the caller's cwd, since `make` needs
# to find the Makefile and git invokes this hook with cwd unspecified.
cd "$(git rev-parse --show-toplevel)"

# `make ci` rebuilds with CI_MODE=1 (which excludes the GUI/sandbox tests
# that need a display) and runs the full suite. A non-zero exit -- a build
# error or a crashing/failing test -- aborts the push via `set -e` below.
echo "pre-push: running \`make ci\`..." >&2
if ! make ci --no-print-directory; then
  echo "pre-push: \`make ci\` failed, aborting push" >&2
  exit 1
fi

exit 0
